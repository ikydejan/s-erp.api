# --- Postgres (write side, source of truth) ---
DATABASE_URL=postgres://erp:erp@localhost:5432/erp

# --- OpenSearch (read side) ---
OPENSEARCH_URL=http://localhost:9200

# --- HTTP server ---
API_HOST=0.0.0.0
API_PORT=8080

# --- Auth ---
# openssl rand -base64 48
JWT_SECRET=change-me-in-production-min-32-bytes-long
JWT_ACCESS_TOKEN_TTL_MINUTES=15
JWT_REFRESH_TOKEN_TTL_DAYS=7

# AES-256 key (32 bytes, base64) used to encrypt MFA TOTP secrets at rest.
# openssl rand -base64 32
MFA_ENCRYPTION_KEY=change-me-32-byte-base64-key-here==

# --- Web Push (VAPID) ---
# Generate with: cargo run -p worker --bin gen_vapid_keys  (see README)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# --- Logging ---
RUST_LOG=info,api=debug,worker=debug,sqlx=warn
